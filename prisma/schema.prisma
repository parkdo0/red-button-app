// ============================================
// 레드버튼(RedButton) 태블릿 앱 클론 - DB 스키마 v3
// Stack: Prisma 7 + MySQL 8
// 본사(HQ) + 매장(Store) 2계층 관리 구조
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================
// 0. 관리자 계정 (Admin User)
// ============================================

enum AdminRole {
  HQ_ADMIN      // 본사 관리자 (전체 권한)
  STORE_MANAGER // 매장 점장 (매장 전체 권한)
  STORE_STAFF   // 매장 직원 (주문/채팅만)
}

/// 관리자 계정
model AdminUser {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(100)
  password  String    @db.VarChar(255) // bcrypt 해시
  name      String    @db.VarChar(50)
  role      AdminRole @default(STORE_STAFF)
  storeId   Int?      // null = 본사, 값 있으면 해당 매장 소속
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("admin_users")
}

// ============================================
// 1. 매장 / 테이블 (Store & Table)
// ============================================

/// 매장 정보 (프랜차이즈 멀티 매장)
model Store {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100) // "수원점"
  address      String?  @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  wifiId       String?  @db.VarChar(50)  // "redbutton"
  wifiPw       String?  @db.VarChar(50)  // "red2563799"
  openTime     String?  @db.VarChar(10)  // "10:00"
  closeTime    String?  @db.VarChar(10)  // "23:00"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tables     Table[]
  orders     Order[]
  sessions   TableSession[]
  admins     AdminUser[]
  storeGames StoreGame[]
  storeMenus StoreMenu[]

  @@map("stores")
}

/// 매장 내 테이블 (태블릿 배치 단위)
model Table {
  id       Int     @id @default(autoincrement())
  storeId  Int
  tableNo  String  @db.VarChar(10)
  seats    Int     @default(4)
  isActive Boolean @default(true)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders   Order[]
  sessions TableSession[]

  @@unique([storeId, tableNo])
  @@map("tables")
}

/// 테이블 이용 세션 (입장~퇴장)
model TableSession {
  id         Int       @id @default(autoincrement())
  storeId    Int
  tableId    Int
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  guestCount Int       @default(2)

  store Store @relation(fields: [storeId], references: [id])
  table Table @relation(fields: [tableId], references: [id])

  @@index([storeId, tableId])
  @@map("table_sessions")
}

// ============================================
// 2. 카테고리 (F&B 탭 구분용)
// ============================================

enum CategoryType {
  FOOD // F&B 탭: 푸드, 음료, 벌칙메뉴, MD상품
}

/// F&B 카테고리
model Category {
  id           Int          @id @default(autoincrement())
  type         CategoryType @default(FOOD)
  name         String       @db.VarChar(50)
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  menus Menu[]

  @@unique([type, name])
  @@map("categories")
}

// ============================================
// 3. 보드게임 (Game) - 본사 마스터 데이터
// ============================================

enum Difficulty {
  VERY_EASY
  EASY
  NORMAL
  SEMI_HARD
  HARD
  EXTREME
}

/// 보드게임 마스터 (본사에서 관리)
model Game {
  id                 Int        @id @default(autoincrement())
  title              String     @db.VarChar(100)
  description        String?    @db.Text
  thumbnailUrl       String?    @db.VarChar(500)
  videoUrl           String?    @db.VarChar(500)
  minPlayers         Int        @default(2)
  maxPlayers         Int        @default(4)
  recommendedPlayers String     @db.VarChar(20)  // "3-5인"
  playTime           Int?                         // 분 단위
  playTimeCategory   String     @db.VarChar(20)  // "15-30분"
  difficulty         Difficulty @default(NORMAL)
  defaultShelfLoc    String     @db.VarChar(20)  // 기본 진열 위치 (매장에서 오버라이드 가능)
  isActive           Boolean    @default(true)   // 본사 레벨 활성화
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tags       GameTag[]
  hashtags   GameHashtag[]
  storeGames StoreGame[]

  @@index([difficulty])
  @@index([playTimeCategory])
  @@fulltext([title])
  @@map("games")
}

/// 태그 (필터링 기준)
model Tag {
  id           Int    @id @default(autoincrement())
  group        String @db.VarChar(30) // "genre" | "player_count"
  value        String @db.VarChar(50) // "전략", "2인"
  displayOrder Int    @default(0)

  games GameTag[]

  @@unique([group, value])
  @@map("tags")
}

/// Game ↔ Tag M:N
model GameTag {
  gameId Int
  tagId  Int

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@map("game_tags")
}

/// 게임 해시태그 (빨간 글씨)
model GameHashtag {
  id     Int    @id @default(autoincrement())
  gameId Int
  text   String @db.VarChar(50)
  order  Int    @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_hashtags")
}

// ============================================
// 3-1. 매장별 게임 보유 현황 (Store ↔ Game)
// ============================================

/// 매장별 게임 보유 & 노출 설정
/// 본사 Game 마스터에서 "우리 매장에 있는 게임"을 체크
model StoreGame {
  storeId       Int
  gameId        Int
  isVisible     Boolean @default(true)  // 태블릿 노출 여부
  shelfLocation String? @db.VarChar(20) // 매장별 진열 위치 오버라이드 (null이면 Game.defaultShelfLoc)
  createdAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([storeId, gameId])
  @@map("store_games")
}

// ============================================
// 3-2. 추천 카테고리 (홈 화면 Row)
// ============================================

model RecommendCategory {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(100)
  subtitle String  @db.VarChar(200)
  emoji    String  @db.VarChar(10)
  order    Int     @default(0)
  isActive Boolean @default(true)

  items RecommendCategoryItem[]

  @@map("recommend_categories")
}

model RecommendCategoryItem {
  categoryId Int
  gameId     Int
  order      Int @default(0)

  category RecommendCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, gameId])
  @@map("recommend_category_items")
}

// ============================================
// 4. F&B 메뉴 - 본사 마스터 데이터
// ============================================

/// F&B 메뉴 마스터 (본사에서 관리)
model Menu {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  imageUrl     String?  @db.VarChar(500)
  basePrice    Int
  isNew        Boolean  @default(false)
  isBest       Boolean  @default(false)
  isActive     Boolean  @default(true)  // 본사 레벨 활성화
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category          @relation(fields: [categoryId], references: [id])
  optionGroups MenuOptionGroup[]
  orderItems   OrderItem[]
  storeMenus   StoreMenu[]

  @@index([categoryId])
  @@map("menus")
}

/// 메뉴 옵션 그룹
model MenuOptionGroup {
  id           Int     @id @default(autoincrement())
  menuId       Int
  name         String  @db.VarChar(50)
  isRequired   Boolean @default(false)
  maxSelect    Int     @default(1)
  displayOrder Int     @default(0)

  menu    Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  options MenuOption[]

  @@map("menu_option_groups")
}

/// 개별 옵션 항목
model MenuOption {
  id           Int     @id @default(autoincrement())
  groupId      Int
  name         String  @db.VarChar(50)
  extraPrice   Int     @default(0)
  isAvailable  Boolean @default(true)
  displayOrder Int     @default(0)

  group            MenuOptionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@map("menu_options")
}

// ============================================
// 4-1. 매장별 메뉴 설정 (Store ↔ Menu)
// ============================================

/// 매장별 메뉴 판매 & 가격 설정
/// 매장에서 품절 토글, 가격 오버라이드 가능
model StoreMenu {
  storeId       Int
  menuId        Int
  isAvailable   Boolean @default(true)  // 판매중/품절
  priceOverride Int?                    // null이면 Menu.basePrice 사용
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([storeId, menuId])
  @@map("store_menus")
}

// ============================================
// 5. 주문 시스템
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

model Order {
  id         Int         @id @default(autoincrement())
  storeId    Int
  tableId    Int
  status     OrderStatus @default(PENDING)
  totalPrice Int         @default(0)
  memo       String?     @db.VarChar(500)
  orderedAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  store Store       @relation(fields: [storeId], references: [id])
  table Table       @relation(fields: [tableId], references: [id])
  items OrderItem[]

  @@index([storeId, tableId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  menuId    Int
  menuName  String @db.VarChar(100)
  basePrice Int
  quantity  Int    @default(1)
  subTotal  Int

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu    Menu              @relation(fields: [menuId], references: [id])
  options OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id          Int    @id @default(autoincrement())
  orderItemId Int
  optionId    Int
  optionName  String @db.VarChar(50)
  extraPrice  Int

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    MenuOption @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

// ============================================
// 6. 카운터 쪽지 (채팅)
// ============================================

enum MessageSender {
  STORE
  CUSTOMER
}

model ChatMessage {
  id        Int           @id @default(autoincrement())
  storeId   Int
  tableNo   String        @db.VarChar(10)
  sender    MessageSender
  text      String        @db.Text
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([storeId, tableNo, createdAt])
  @@map("chat_messages")
}

// ============================================
// 7. 이벤트 배너
// ============================================

model Event {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  subtitle    String?   @db.VarChar(200)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@map("events")
}
