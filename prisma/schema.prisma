// ============================================
// 레드버튼(RedButton) 태블릿 앱 클론 - DB 스키마
// Stack: Prisma 7 + MySQL 8
// 실제 앱 스크린샷 기준으로 설계 (2026.02)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. 매장 / 테이블 (Store & Table)
// ============================================

/// 매장 정보 (멀티 매장 대응 - 프랜차이즈)
model Store {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100) // "수원점"
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  wifiId    String?  @db.VarChar(50) // "redbutton"
  wifiPw    String?  @db.VarChar(50) // "red2563799"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables   Table[]
  orders   Order[]
  sessions TableSession[]

  @@map("stores")
}

/// 매장 내 테이블 (태블릿 배치 단위)
model Table {
  id       Int     @id @default(autoincrement())
  storeId  Int
  tableNo  String  @db.VarChar(10) // "31"
  seats    Int     @default(4)
  isActive Boolean @default(true)

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders   Order[]
  sessions TableSession[]

  @@unique([storeId, tableNo])
  @@map("tables")
}

/// 테이블 이용 세션 (입장~퇴장, 이용 시간 추적)
model TableSession {
  id          Int       @id @default(autoincrement())
  storeId     Int
  tableId     Int
  checkInAt   DateTime  @default(now())
  checkOutAt  DateTime?
  guestCount  Int       @default(2)

  store Store @relation(fields: [storeId], references: [id])
  table Table @relation(fields: [tableId], references: [id])

  @@index([storeId, tableId])
  @@map("table_sessions")
}

// ============================================
// 2. 카테고리 (게임 장르 & F&B 탭 통합)
// ============================================

enum CategoryType {
  GAME // 게임 장르용 (현재 미사용 - Tag로 대체)
  FOOD // F&B 탭 메뉴: 푸드, 음료, 벌칙메뉴, MD상품
}

/// 카테고리 (주로 F&B 탭 구분용)
model Category {
  id           Int          @id @default(autoincrement())
  type         CategoryType
  name         String       @db.VarChar(50) // "푸드", "음료", "벌칙메뉴", "MD상품"
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  menus Menu[]

  @@unique([type, name])
  @@map("categories")
}

// ============================================
// 3. 보드게임 (Game) + 태그 M:N 필터링
// ============================================

/// 난이도 6단계 (실제 앱 기준)
enum Difficulty {
  VERY_EASY
  EASY
  NORMAL
  SEMI_HARD
  HARD
  EXTREME
}

/// 보드게임
model Game {
  id                 Int        @id @default(autoincrement())
  title              String     @db.VarChar(100)
  description        String?    @db.Text
  thumbnailUrl       String?    @db.VarChar(500)
  videoUrl           String?    @db.VarChar(500) // 유튜브 룰 설명 영상
  minPlayers         Int        @default(2)
  maxPlayers         Int        @default(4)
  recommendedPlayers String     @db.VarChar(20) // "3-5인" (추천 인원 텍스트)
  playTime           Int? // 분 단위
  playTimeCategory   String     @db.VarChar(20) // "15-30분" (필터용)
  difficulty         Difficulty @default(NORMAL)
  shelfLocation      String     @db.VarChar(20) // 진열 위치 "ㄱㄴㄷ-6"
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tags     GameTag[]
  hashtags GameHashtag[]

  @@index([difficulty])
  @@index([playTimeCategory])
  @@fulltext([title]) // 초성 검색은 앱 레벨에서 처리, DB는 FULLTEXT 보조
  @@map("games")
}

/// 태그 (필터링 기준 - 실제 앱의 3가지 필터 축)
/// group: "genre" | "player_count" | "play_time"
model Tag {
  id           Int    @id @default(autoincrement())
  group        String @db.VarChar(30)
  value        String @db.VarChar(50)
  displayOrder Int    @default(0)

  games GameTag[]

  @@unique([group, value])
  @@map("tags")
}

/// Game ↔ Tag M:N 중간 테이블
model GameTag {
  gameId Int
  tagId  Int

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@map("game_tags")
}

/// 게임 해시태그 (실제 앱에서 빨간 글씨로 표시되는 태그)
/// e.g. "#내 것도 내 거", "#네 것도 내 거"
model GameHashtag {
  id     Int    @id @default(autoincrement())
  gameId Int
  text   String @db.VarChar(50) // "내 것도 내 거" (# 제외)
  order  Int    @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_hashtags")
}

/// 추천 카테고리 (홈 화면 가로 스크롤 Row)
/// 실제 앱처럼 감성적 제목 + 이모지
model RecommendCategory {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(100) // "입문자를 위해 엄선한\n재미보장 보드게임"
  subtitle String @db.VarChar(200) // 부제목
  emoji    String @db.VarChar(10)  // "🎲"
  order    Int    @default(0)
  isActive Boolean @default(true)

  items RecommendCategoryItem[]

  @@map("recommend_categories")
}

/// 추천 카테고리 ↔ 게임 연결
model RecommendCategoryItem {
  categoryId Int
  gameId     Int
  order      Int @default(0)

  category RecommendCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, gameId])
  @@map("recommend_category_items")
}

// ============================================
// 4. F&B 메뉴 (Menu) + 옵션 그룹핑
// ============================================

/// F&B 메뉴 아이템
model Menu {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  imageUrl     String?  @db.VarChar(500)
  basePrice    Int      // 원 단위
  isAvailable  Boolean  @default(true)
  isNew        Boolean  @default(false) // NEW 뱃지 표시
  isBest       Boolean  @default(false) // BEST 뱃지 표시
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category          @relation(fields: [categoryId], references: [id])
  optionGroups MenuOptionGroup[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@map("menus")
}

/// 메뉴 옵션 그룹 (e.g. "맛 선택", "사이즈")
model MenuOptionGroup {
  id           Int     @id @default(autoincrement())
  menuId       Int
  name         String  @db.VarChar(50)
  isRequired   Boolean @default(false)
  maxSelect    Int     @default(1)
  displayOrder Int     @default(0)

  menu    Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  options MenuOption[]

  @@map("menu_option_groups")
}

/// 개별 옵션 항목 (e.g. "순한맛 +0원", "라지 +1,500원")
model MenuOption {
  id           Int     @id @default(autoincrement())
  groupId      Int
  name         String  @db.VarChar(50)
  extraPrice   Int     @default(0)
  isAvailable  Boolean @default(true)
  displayOrder Int     @default(0)

  group            MenuOptionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@map("menu_options")
}

// ============================================
// 5. 주문 시스템 (Order)
// ============================================

enum OrderStatus {
  PENDING    // 접수 대기
  CONFIRMED  // 접수 완료
  PREPARING  // 준비 중 (주문 진행중)
  COMPLETED  // 완료
  CANCELLED  // 취소됨
}

/// 주문 (테이블 단위, 복수 주문 가능)
model Order {
  id         Int         @id @default(autoincrement())
  storeId    Int
  tableId    Int
  status     OrderStatus @default(PENDING)
  totalPrice Int         @default(0) // 원 단위
  memo       String?     @db.VarChar(500)
  orderedAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  store Store       @relation(fields: [storeId], references: [id])
  table Table       @relation(fields: [tableId], references: [id])
  items OrderItem[]

  @@index([storeId, tableId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

/// 주문 항목 (주문 시점 스냅샷 - 메뉴 가격 변경에 영향 안 받음)
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  menuId    Int
  menuName  String @db.VarChar(100) // 스냅샷
  basePrice Int                     // 스냅샷
  quantity  Int    @default(1)
  subTotal  Int                     // (basePrice + 옵션합) * quantity

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu    Menu              @relation(fields: [menuId], references: [id])
  options OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

/// 주문 항목별 선택 옵션 (스냅샷)
model OrderItemOption {
  id          Int    @id @default(autoincrement())
  orderItemId Int
  optionId    Int
  optionName  String @db.VarChar(50) // 스냅샷
  extraPrice  Int                    // 스냅샷

  orderItem OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    MenuOption @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

// ============================================
// 6. 카운터 쪽지 (채팅)
// ============================================

enum MessageSender {
  STORE    // 매장 → 고객
  CUSTOMER // 고객 → 매장
}

/// 카운터 쪽지 메시지
model ChatMessage {
  id        Int           @id @default(autoincrement())
  storeId   Int
  tableNo   String        @db.VarChar(10)
  sender    MessageSender
  text      String        @db.Text
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([storeId, tableNo, createdAt])
  @@map("chat_messages")
}

// ============================================
// 7. 이벤트 배너
// ============================================

/// 이벤트 (풀스크린 캐러셀)
model Event {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100)
  subtitle    String?  @db.VarChar(200)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())

  @@map("events")
}
